PORT=4000
NODE_ENV=development

# Required in production. Used to sign/verify the 8-hour login JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: Neon Postgres connection string. If unset, uses built-in in-memory repository with zero setup.
# After setting this, run: npm run db:migrate && npm run db:seed
DATABASE_URL=

# Optional: Vercel Blob read/write token for cloud document storage. If unset, uses local ./uploads directory.
# IMPORTANT: Never commit this token. Server-side only. Never sent to the client.
BLOB_READ_WRITE_TOKEN=

# Storage mode: local (default) | postgres (JSONB bytes) | blob (Vercel Blob private)
# Set to 'blob' and provide BLOB_READ_WRITE_TOKEN to enable Vercel Blob storage.
STORAGE_MODE=local

# Local storage: directory for uploaded files when STORAGE_MODE=local.
UPLOAD_DIR=./uploads

# Optional: AI Gateway API key for multimodal LLM vision document extraction. If unset, uses deterministic mock extractor.
AI_GATEWAY_API_KEY=

# Optional: Override for the AI Gateway base URL. Leave unset for the default gateway.
AI_GATEWAY_BASE_URL=

# Optional: Model identifier for AI extraction (e.g. gpt-4o-mini). Defaults to gpt-4o-mini when AI_GATEWAY_API_KEY is present.
EXTRACTION_MODEL=gpt-4o-mini

# Secret token for cron endpoints. /cron/expiry-check falls back to
# 'dev-cron-secret' locally, but /cron/alerts REFUSES to run (HTTP 503) unless
# this is explicitly set.
CRON_SECRET=dev-cron-secret

# ---- Phase C: Alert email delivery ----
# Mail mode: log (default, prints messages), ethereal (test inbox + preview URL), live (SMTP).
MAIL_MODE=log
MAIL_FROM=no-reply@vishwas.local
# Required only when MAIL_MODE=live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: redirect all demo alert email to one inbox. Original role recipient is still recorded.
ALERT_EMAIL_OVERRIDE=
# Used for the portal link inside alert emails.
PORTAL_URL=http://localhost:3000
# Demo convenience: allow x-role header authentication when no JWT is supplied.
# Keep false in production.
ALLOW_DEMO_HEADER_ROLE=false

# Optional: URL of the Python OR-Tools VRP Optimizer service (e.g. http://localhost:8000 or Vercel Python runtime).
# If unset, uses built-in pure TypeScript vehicle routing solver with identical constraints.
OPTIMIZER_URL=

# R1: AES-256-GCM encryption key for securing bank account numbers at rest.
# Must be a 32-byte hex string (64 chars) or 32-character utf-8 string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional test-only: disposable Postgres database for persistence tests. Never point this at production.
TEST_DATABASE_URL=

# Part 3 dashboards introduce no additional environment variable names.
