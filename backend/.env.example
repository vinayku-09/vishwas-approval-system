PORT=4000
NODE_ENV=development

# Optional: Neon Postgres connection string. If unset, uses built-in in-memory repository with zero setup.
DATABASE_URL=

# Optional: Vercel Blob read/write token for cloud document storage. If unset, uses local ./uploads directory.
BLOB_READ_WRITE_TOKEN=

# Optional: AI Gateway API key for multimodal LLM vision document extraction. If unset, uses deterministic mock extractor.
AI_GATEWAY_API_KEY=

# Optional: Model identifier for AI extraction (e.g. gpt-4o-mini). Defaults to gpt-4o-mini when AI_GATEWAY_API_KEY is present.
EXTRACTION_MODEL=gpt-4o-mini

# Optional: Secret token for /cron/expiry-check. Defaults to 'dev-cron-secret' for local testing if unset.
CRON_SECRET=dev-cron-secret
